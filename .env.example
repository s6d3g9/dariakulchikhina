# Application environment — production
# Copy to .env and fill in real values
# Generate secrets: openssl rand -base64 32

DATABASE_URL=postgresql://daria:YOUR_DB_PASSWORD@localhost:5433/daria_admin
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6380
NUXT_SESSION_SECRET=GENERATE_WITH_openssl_rand_base64_32
DESIGNER_INITIAL_EMAIL=admin@example.com
DESIGNER_INITIAL_PASSWORD=
UPLOAD_DIR=/opt/daria-nuxt/data/uploads
YANDEX_MAPS_API_KEY=
ANTHROPIC_API_KEY=
OUTBOX_ENABLED=false
