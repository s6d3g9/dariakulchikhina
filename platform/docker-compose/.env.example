# Локальный dev-стек v6 — переменные окружения
# Скопируй в `.env` и настрой при необходимости.

# ─── Postgres ────────────────────────────────────────────────
POSTGRES_USER=daria
POSTGRES_PASSWORD=daria
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────
REDIS_PORT=6379

# ─── NATS JetStream ──────────────────────────────────────────
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# ─── Temporal ────────────────────────────────────────────────
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080

# ─── MinIO (S3) ──────────────────────────────────────────────
MINIO_ROOT_USER=daria
MINIO_ROOT_PASSWORD=daria-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Meilisearch ─────────────────────────────────────────────
MEILI_MASTER_KEY=daria-dev-key-change-me
MEILI_PORT=7700

# ─── Zitadel ─────────────────────────────────────────────────
ZITADEL_PORT=8081

# ─── Mailhog ─────────────────────────────────────────────────
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ─── ClickHouse (observability profile) ──────────────────────
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9100
